# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Arquivos temporarios de commit
*.tmp
public/catalogo/*.pdf
!public/catalogo/catalogo-jr.pdf
!public/catalogo/lareiras-jr.pdf
# Recortes do catálogo (scripts/jr-catalogo-recortes.ts). São servidos como
# arquivo estático, então precisam estar no repo — a regra acima os ignorava
# em silêncio e o deploy subiu sem eles (404 em produção, 17/09).
!public/catalogo/jr-conjuntos-com-fogao.pdf
!public/catalogo/jr-churrasqueiras.pdf
!public/catalogo/jr-fogoes-e-fornos.pdf
!public/catalogo/jr-complementos.pdf
# saída das simulações de replay (offline; nunca versionar)
sim-jr/
sim-*/

# app mobile (Expo/RN)
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/dist/
